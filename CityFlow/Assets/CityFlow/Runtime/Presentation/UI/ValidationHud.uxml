<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="ValidationHud.uss" />
    <ui:Template name="HoverDetails" src="HoverDetails.uxml" />
    <ui:VisualElement name="validation-hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="city-viewport" class="city-viewport" picking-mode="Ignore" />
        <ui:VisualElement name="source-danger" class="source-danger" picking-mode="Ignore" />
        <ui:VisualElement class="node-360-bottom-backdrop" picking-mode="Ignore" />
        <ui:VisualElement class="node-360-right-backdrop" picking-mode="Ignore" />
        <ui:VisualElement class="session-controls interactive layout-obstacle">
            <ui:Label name="pause-status" text="RUNNING" class="section-title" />
            <ui:Button name="pause-toggle" text="Pause [Esc]" />
        </ui:VisualElement>
        <ui:VisualElement name="node-labels" class="node-labels" picking-mode="Ignore" />
        <ui:VisualElement name="connection-toast" class="panel connection-toast interactive layout-obstacle">
            <ui:Label name="connection-notice" class="detail-text" />
            <ui:Button name="undo-connection" text="Undo [Ctrl+Z / ⌘Z]" />
        </ui:VisualElement>
        <ui:VisualElement class="panel summary-panel layout-obstacle">
            <ui:VisualElement class="metrics">
                <ui:VisualElement class="metric">
                    <ui:Label text="DELIVERED" class="metric-caption" />
                    <ui:Label name="delivered-value" text="0" class="metric-value" />
                </ui:VisualElement>
                <ui:VisualElement class="metric">
                    <ui:Label text="TIME" class="metric-caption" />
                    <ui:Label name="elapsed-value" text="0:00" class="metric-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="wave-value" text="WAVE 1" class="wave-readout" />
        </ui:VisualElement>
        <ui:VisualElement name="route-handles" class="connection-markers" picking-mode="Ignore" />
        <ui:VisualElement name="route-editor" class="panel route-editor interactive layout-obstacle">
            <ui:Label text="GROUND / MANUAL ROUTE" class="section-title" />
            <ui:Label text="Shift + click: add a point to nearest segment&#10;Drag numbered handles: move on Ground&#10;Select a handle + Delete: remove&#10;Endpoints stay fixed on Nodes.&#10;WASD / middle drag: pan · Wheel: zoom" class="detail-text" />
            <ui:Label name="edit-route-feedback" class="detail-text route-feedback" />
            <ui:Label name="route-point-detail" class="band-hint" />
            <ui:Button name="route-remove" text="Remove selected point [Delete]" />
            <ui:Button name="route-regenerate" text="Regenerate automatic route" />
            <ui:Button name="route-apply" text="Apply Line [Enter]" />
            <ui:Button name="route-cancel" text="Cancel [Backspace]" />
        </ui:VisualElement>
        <ui:VisualElement name="connection-markers" class="connection-markers" picking-mode="Ignore" />
        <ui:VisualElement name="connection-workspace" class="connection-workspace" picking-mode="Ignore">
            <ui:VisualElement name="connection-panel" class="panel connection-panel interactive layout-obstacle">
                <ui:Label name="connect-mode" text="OVERVIEW / CONNECTION" class="section-title" />
                <ui:Label name="connect-selection" class="detail-text" />
                <ui:VisualElement name="line-actions">
                    <ui:Label name="line-action-detail" class="detail-text" />
                    <ui:Button name="line-edit" text="Edit selected Line" />
                    <ui:Button name="line-delete" text="Reserve deletion" />
                    <ui:Button name="line-cancel" text="Cancel pending change" />
                </ui:VisualElement>
                <ui:VisualElement class="connection-only">
                    <ui:Label name="connection-bands" class="band-hint" />
                    <ui:VisualElement class="band-buttons">
                        <ui:Button name="band-all" text="All" />
                        <ui:Button name="band-near" text="Near" />
                        <ui:Button name="band-mid" text="Mid" />
                        <ui:Button name="band-far" text="Far" />
                    </ui:VisualElement>
                    <ui:Label name="connection-count" class="band-hint" />
                    <ui:Label name="candidate-detail" class="detail-text candidate-detail" />
                    <ui:Label name="connection-help" text="Hover / Tab: preview a route.&#10;Click a Node or candidate: connect.&#10;E: edit route before connecting." class="band-hint" />
                    <ui:Button name="connect-review" text="Review in Overview [V]" />
                    <ui:Button name="connect-cancel" text="Cancel connection [Backspace]" />
                    <ui:Label name="route-feedback" class="detail-text route-feedback" />
                    <ui:Button name="connect-confirm" text="Confirm Line [Enter]" />
                    <ui:Button name="route-edit" text="Edit Ground route [E]" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="candidate-list-panel" class="panel candidate-list-panel interactive layout-obstacle">
                <ui:Label text="CONNECTION TARGETS" class="section-title" />
                <ui:Label name="candidate-list-count" class="band-hint" />
                <ui:ScrollView name="connection-candidates" mode="Vertical" horizontal-scroller-visibility="Hidden" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="context-hint" class="context-hint layout-obstacle" picking-mode="Ignore" />
        <ui:VisualElement name="node-tooltip" class="panel hover-panel layout-obstacle" picking-mode="Ignore">
            <ui:Instance template="HoverDetails" />
        </ui:VisualElement>
        <ui:Label name="wave-notice" class="wave-notice layout-obstacle" picking-mode="Ignore" />
        <ui:VisualElement name="arrival-markers" class="connection-markers" picking-mode="Ignore" />
        <ui:VisualElement name="result-overlay" class="result-overlay interactive">
            <ui:VisualElement class="panel result-panel">
                <ui:Label name="result-title" text="GAME OVER" class="title" />
                <ui:Label name="result-detail" class="result-detail" />
                <ui:Label text="Keep the Source moving.&#10;Use Pause to plan and reconnect your network." class="detail-text" />
                <ui:Button name="retry-session" text="Retry" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="FIXED VALIDATION CITY    ·    STRAIGHT / DETOUR / NARROW PASSAGE" class="city-caption" />
    </ui:VisualElement>
</ui:UXML>
