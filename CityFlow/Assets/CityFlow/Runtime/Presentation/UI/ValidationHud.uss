.hud {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    color: rgb(235, 241, 249);
    font-size: 16px;
}
Label { margin: 0; padding: 0; }
.panel {
    background-color: rgba(5, 9, 15, 0.94);
    border-width: 1px;
    border-color: rgb(35, 49, 63);
    border-radius: 4px;
    padding: 18px;
}
.summary-panel { position: absolute; left: 24px; top: 24px; width: 360px; padding: 14px; }
.title { font-size: 30px; -unity-font-style: bold; margin-bottom: 16px; }
.subtitle { margin-bottom: 12px; }
.summary { color: rgb(173, 192, 207); font-size: 15px; margin-bottom: 8px; }
.metrics { flex-direction: row; align-items: center; margin-top: 0; }
.metric { flex-direction: row; align-items: baseline; margin-right: 26px; }
.metric-caption { color: rgb(180, 198, 213); font-size: 14px; margin-right: 10px; }
.metric-value { font-size: 23px; -unity-font-style: bold; }
.readouts { position: absolute; right: 24px; top: 24px; width: 332px; }
.line-panel { margin-top: 0; }
.section-title { -unity-font-style: bold; margin-bottom: 18px; }
.table-row { flex-direction: row; align-items: center; height: 34px; }
.table-header { height: 24px; font-size: 12px; color: rgb(143, 165, 184); }
.connection { width: 64px; }
.buffer { flex-grow: 1; -unity-text-align: middle-right; }
.line-name { width: 95px; }
.length { width: 62px; }
.duration { width: 59px; }
.load { flex-grow: 1; -unity-text-align: middle-right; }
.full { color: rgb(255, 197, 91); }
.node-labels { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.node-label {
    position: absolute;
    width: 156px; height: 30px;
    translate: -50% -100%;
    background-color: rgba(10, 17, 25, 0.75);
    border-width: 1px;
    border-color: rgb(62, 79, 94);
    border-radius: 3px;
    -unity-text-align: middle-center;
    font-size: 12px;
}
.footer { position: absolute; left: 32px; bottom: 28px; font-size: 15px; color: rgb(182, 200, 214); }
.detail-text { white-space: normal; font-size: 14px; color: rgb(195, 212, 226); }
.city-caption { display: none; }
.node-gauge { position: absolute; left: 4px; right: 4px; bottom: 2px; height: 3px; background-color: rgb(44, 53, 65); }
.node-fill { height: 100%; background-color: rgb(203, 215, 228); }
.input-stopped { border-color: rgb(255, 197, 91); }
.input-stopped .node-fill { background-color: rgb(255, 197, 91); }
.readouts .panel { padding: 14px; }
.readouts .table-row { height: 26px; }
.readouts .section-title { margin-bottom: 12px; }
.connection-panel { position: absolute; left: 50%; bottom: 80px; translate: -50% 0; width: 340px; }
.connection-panel .section-title { font-size: 15px; margin-bottom: 10px; }
.interactive Button {
    background-color: rgb(29,64,73); color: rgb(235,249,247);
    border-width: 1px; border-color: rgb(76,125,128); min-height: 30px;
    margin-top: 8px;
}
.interactive Button:hover { background-color: rgb(44,90,100); }
.interactive Button:disabled { background-color: rgb(22,30,38); color: rgb(113,132,144); }
.connection-only { display: none; }
.connection-active .connection-only { display: flex; }
.connection-active .overview-footer { display: none; }
.connection-active .connection-panel { left: 24px; top: 24px; bottom: auto; translate: 0 0; width: 355px; }
.connection-active .summary-panel { display: none; }
.band-hint { font-size: 12px; color: rgb(155,180,198); white-space: normal; margin-top: 12px; }
.band-buttons { flex-direction: row; }
.band-buttons Button { flex-grow: 1; margin-right: 4px; }
.interactive Button.chosen { border-color: rgb(98,246,221); background-color: rgb(34,88,90); }
.candidate-detail { margin-top: 18px; min-height: 105px; white-space: normal; }
.connection-markers { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.candidate-marker {
    position: absolute; width: 200px; height: 68px; font-size: 12px;
    background-color: rgba(6,24,33,0.95); color: rgb(214,236,248);
    border-width: 1px; border-color: rgb(93,160,169); border-radius: 4px;
    -unity-text-align: middle-center; white-space: normal;
}
.candidate-marker.chosen { border-width: 2px; border-color: rgb(97,250,220); background-color: rgba(22,61,69,0.98); }
.candidate-marker.blocked { color: rgb(248,196,114); }
.candidate-marker.occluded { border-top-width: 3px; }
.candidate-marker:hover { background-color: rgb(36,78,89); }
.candidate-list-panel { display: none; position: absolute; right: 24px; top: 24px;
    width: 332px; max-height: 55%; padding: 14px; }
.node-360 .candidate-list-panel { display: flex; }
.candidate-list-panel .section-title { margin-bottom: 0; }
.candidate-list-panel .band-hint { margin-top: 8px; margin-bottom: 8px; font-size: 11px; }
#connection-candidates { flex-shrink: 1; }
.candidate-list-panel Button.candidate-option { height: 50px; min-height: 50px; flex-shrink: 0;
    margin: 0 2px 4px 0; padding: 5px 10px; font-size: 12px; white-space: normal; -unity-text-align: middle-left; }
.candidate-list-panel Button.blocked { color: rgb(248,196,114); }
.candidate-list-panel .unity-scroller--vertical { width: 12px; background-color: rgb(15,25,34); }
.candidate-list-panel .unity-scroller__low-button, .candidate-list-panel .unity-scroller__high-button { display: none; }
.candidate-list-panel .unity-base-slider__tracker { background-color: rgb(22,35,46); }
.candidate-list-panel .unity-base-slider__dragger { background-color: rgb(78,115,131); border-radius: 4px; }

.route-editor { display: none; position: absolute; left: 24px; top: 24px; width: 330px; }
.route-editing .route-editor { display: flex; }
.route-handle { position: absolute; width: 30px; height: 30px; border-radius: 15px;
    background-color: rgb(12,48,59); color: rgb(147,255,232); border-width: 2px; border-color: rgb(96,221,210);
    -unity-text-align: middle-center; font-size: 13px; }
.route-handle.chosen { background-color: rgb(126,87,26); border-color: rgb(255,207,107); }
.route-handle.endpoint { background-color: rgb(32,41,54); color: rgb(186,201,213); }

.connection-active #line-actions { display: none; }
#line-action-detail { margin-top: 10px; }

.session-controls { position: absolute; left: 50%; top: 24px; translate: -50% 0;
    background-color: rgba(5,9,15,0.95); padding: 12px 20px; border-width: 1px; border-color: rgb(76,125,128); width: 285px; }
.session-controls .section-title { margin-bottom: 0; font-size: 14px; -unity-text-align: middle-center; }
.session-controls.paused { border-color: rgb(255,207,107); }
.session-controls.paused Label { color: rgb(255,207,107); }

.readouts { max-height: 45%; }
.wave-notice { position: absolute; left: 50%; top: 125px; translate: -50% 0; width: 340px;
    font-size: 14px; -unity-text-align: middle-center; white-space: normal; padding: 12px;
    color: rgb(255,219,132); background-color: rgba(5,9,15,0.95); }
.arrival-marker { position: absolute; width: 160px; height: 48px; white-space: normal;
    background-color: rgba(28,36,35,0.96); color: rgb(255,219,132); border-width: 2px; border-color: rgb(255,203,83);
    font-size: 12px; -unity-text-align: middle-center; }
.result-overlay { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(2,5,10,0.78); }
.result-panel { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 500px; padding: 32px;
    border-color: rgb(236,175,93); }
.result-panel .title { font-size: 28px; }
.result-detail { white-space: normal; font-size: 24px; margin-top: 20px; margin-bottom: 28px; color: rgb(255,219,154); }
.result-panel Button { height: 46px; margin-top: 24px; }

.readouts .unity-scroller--vertical { width: 12px; background-color: rgb(15,25,34); }
.readouts .unity-scroller__low-button, .readouts .unity-scroller__high-button { display: none; }
.readouts .unity-base-slider__tracker { background-color: rgb(22,35,46); }
.readouts .unity-base-slider__dragger { background-color: rgb(78,115,131); border-radius: 4px; }

.connection-workspace { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.node-360 .connection-workspace { left: 72%; top: 92px; padding: 12px; background-color: rgb(5,9,15); }
.node-360 .connection-workspace .panel { position: relative; left: auto; right: auto; top: auto; bottom: auto;
    translate: 0 0; width: 100%; padding: 10px; margin-bottom: 8px; flex-shrink: 0; }
.node-360 .connection-workspace .section-title { font-size: 14px; margin-bottom: 6px; }
.node-360 #connection-bands, .node-360 #connection-count, .node-360 #connection-help { display: none; }
.node-360 .candidate-detail { min-height: 86px; margin-top: 8px; font-size: 12px; }
.node-360 .connection-workspace .candidate-list-panel { flex-grow: 1; flex-shrink: 1; min-height: 100px; max-height: none; }
.node-360 .candidate-list-panel Button.candidate-option { height: 44px; min-height: 44px; }
.node-360 .session-controls { left: 72%; right: 0; top: 0; width: auto; translate: 0 0; }
.node-360 .wave-notice, .node-360 #arrival-markers { display: none; }
.node-360 .footer { font-size: 11px; bottom: 12px; }

.node-360-bottom-backdrop, .node-360-right-backdrop { display: none; position: absolute; background-color: rgb(5,9,15); }
.node-360 .node-360-bottom-backdrop { display: flex; left: 0; width: 72%; bottom: 0; height: 6%; }
.node-360 .node-360-right-backdrop { display: flex; left: 72%; right: 0; top: 0; bottom: 0; }


.node-360 .readouts, .node-360 .node-labels { display: none; }
.route-editing .connection-panel, .route-editing .readouts,
.route-editing #route-edit, .route-editing .footer, .route-editing #connect-confirm { display: none; }
.node-360 #connect-confirm { display: none; }
.route-feedback { margin-top: 12px; font-size: 12px; }
.hover-panel { display: none; position: absolute; width: 320px; padding: 16px; }
.hover-panel .detail-text { font-size: 13px; white-space: normal; }
.hover-warning { border-color: rgb(255,195,72); background-color: rgb(38,25,17); }
